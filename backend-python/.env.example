# SecureGuard Backend Environment Configuration
# Copy this to .env and update values

# Application
APP_NAME=SecureGuard API
VERSION=2.0.0
DEBUG=false
PORT=8000

# Database
DATABASE_URL=postgresql://secureguard:secure@localhost:5432/secureguard

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8765
RATE_LIMIT_PER_MINUTE=60

# ML Service
ML_MODEL_PATH=./ml_models/threat_model.joblib
ML_THRESHOLD=0.7

# External Services
VIRUSTOTAL_API_KEY=
