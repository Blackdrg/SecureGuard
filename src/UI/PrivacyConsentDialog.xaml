<Window x:Class="SecureGuard.UI.PrivacyConsentDialog"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="Privacy Consent" Height="550" Width="500"
            WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
            Background="#1a1a1a">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0ea5e9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button:Button":Button>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0284c7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
<Style x:Key="DeclineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6b7280"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4b5563"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,24">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🛡️ SecureGuard Privacy Consent" FontSize="28" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="We respect your privacy and need your consent to enable advanced protection features." 
                           FontSize="16" Foreground="#94a3b8" HorizontalAlignment="Center" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="GDPR Compliance Notice" FontSize="18" FontWeight="SemiBold" 
                           Foreground="White" Margin="0,0,20,16"/>
                <TextBlock Text="SecureGuard Enterprise is fully GDPR compliant. You control what data is collected and how it's used. 
We only collect data necessary for threat protection." FontSize="14" Foreground="#94a3b8" 
                           TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="24"/>
                
                <CheckBox Name="TelemetryChk" Content="📊 Telemetry (Optional)&#x0a;Send anonymous usage stats to improve SecureGuard"/>
                <TextBlock Text="Helps us understand protection effectiveness without personal data." FontSize="12" 
                           Foreground="#64748b" Margin="20,0,0,20"/>
                
                <CheckBox Name="WebcamChk" Content="📹 Webcam Protection&#x0a;Monitor and block unauthorized webcam access"/>
                <CheckBox Name="MicChk" Content="🎤 Microphone Protection&#x0a;Prevent unauthorized microphone recording"/>
                
                <CheckBox Name="KeyloggerChk" Content="⌨️ Anti-Keylogger&#x0a;Detect and block keylogging malware"/>
                
                <CheckBox Name="DarkWebChk" Content="🌐 Dark Web Monitoring&#x0a;Check if your data appears on dark web (email only)"/>
                
                <CheckBox Name="CloudSyncChk" Content="☁️ Cloud Sync&#x0a;Sync threat data and settings across devices"/>
                
                <TextBlock FontSize="12" Foreground="#ef4444" Margin="0,16,0,0">
                    ⚠️ Some features require these permissions to work properly. You can change settings anytime in Settings > Privacy.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom">
            <Button Name="DeclineBtn" Content="Decline All" Style="{StaticResource DeclineButtonStyle}" 
                    Click="DeclineBtn_Click" Margin="0,0,12,0" MinWidth="120"/>
            <Button Name="AcceptBtn" Content="Accept &amp; Protect" Click="AcceptBtn_Click" MinWidth="140"/>
        </StackPanel>
    </Grid>
</Window>

