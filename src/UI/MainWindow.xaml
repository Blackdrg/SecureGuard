<Window x:Class="SecureGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureGuard - AI-Powered Cybersecurity Protection"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0d1117"
        WindowStyle="SingleBorderWindow">
        <Window.Resources>
                <!-- Modern Button Style -->
                <Style x:Key="ModernButton"
                                TargetType="Button">
                        <Setter Property="Background"
                                        Value="#238636"/>
                        <Setter Property="Foreground"
                                        Value="White"/>
                        <Setter Property="Padding"
                                        Value="20,12"/>
                        <Setter Property="Margin"
                                        Value="5"/>
                        <Setter Property="FontSize"
                                        Value="14"/>
                        <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                        <Setter Property="BorderThickness"
                                        Value="0"/>
                        <Setter Property="Cursor"
                                        Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                <Setter Property="Background"
                                                                                Value="#2ea043"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                        Value="True">
                                                                <Setter Property="Background"
                                                                                Value="#238636"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                        Value="False">
                                                                <Setter Property="Background"
                                                                                Value="#21262d"/>
                                                                <Setter Property="Foreground"
                                                                                Value="#484f58"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="DangerButton"
                                TargetType="Button"
                                BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Background"
                                        Value="#da3633"/>
                        <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                                Value="True">
                                        <Setter Property="Background"
                                                        Value="#f85149"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <Style x:Key="NavButton"
                                TargetType="Button">
                        <Setter Property="Background"
                                        Value="Transparent"/>
                        <Setter Property="Foreground"
                                        Value="#c9d1d9"/>
                        <Setter Property="Padding"
                                        Value="15,12"/>
                        <Setter Property="Margin"
                                        Value="0,2"/>
                        <Setter Property="HorizontalContentAlignment"
                                        Value="Left"/>
                        <Setter Property="BorderThickness"
                                        Value="0"/>
                        <Setter Property="Cursor"
                                        Value="Hand"/>
                        <Setter Property="FontSize"
                                        Value="14"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                <Setter Property="Background"
                                                                                Value="#21262d"/>
                                                                <Setter Property="Foreground"
                                                                                Value="#ffffff"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Card Style -->
                <Style x:Key="Card"
                                TargetType="Border">
                        <Setter Property="Background"
                                        Value="#161b22"/>
                        <Setter Property="CornerRadius"
                                        Value="12"/>
                        <Setter Property="Padding"
                                        Value="20"/>
                        <Setter Property="Margin"
                                        Value="5"/>
                </Style>
        </Window.Resources>

        <Grid>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0"
                                Background="#010409"
                                BorderBrush="#30363d"
                                BorderThickness="0,0,1,0">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Logo -->
                                <StackPanel Grid.Row="0"
                                                Margin="20,25,20,20">
                                        <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="40"
                                                                Height="40"
                                                                Fill="#238636"
                                                                Margin="0,0,12,0">
                                                        <Ellipse.Effect>
                                                                <DropShadowEffect Color="#238636"
                                                                                BlurRadius="15"
                                                                                ShadowDepth="0"/>
                                                        </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="SecureGuard"
                                                                FontSize="22"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="AI-Powered Security"
                                                        FontSize="11"
                                                        Foreground="#8b949e"
                                                        Margin="52,2,0,0"/>
                                </StackPanel>

                                <!-- Navigation -->
                                <StackPanel Grid.Row="1"
                                                Margin="15,10">
                                        <Button Content="🛡️  Dashboard"
                                                        Style="{StaticResource NavButton}"
                                                        Click="Dashboard_Click"/>
                                        <Button Content="🔍  Smart Scan"
                                                        Style="{StaticResource NavButton}"
                                                        Click="QuickScan_Click"/>
                                        <Button Content="💾  Full System Scan"
                                                        Style="{StaticResource NavButton}"
                                                        Click="FullScan_Click"/>
                                        <Button Content="📂  Custom Scan"
                                                        Style="{StaticResource NavButton}"
                                                        Click="CustomScan_Click"/>
                                        <Button Content="⚡  Real-Time Protection"
                                                        Style="{StaticResource NavButton}"
                                                        Click="RealTime_Click"/>
                                        <Button Content="📁  Quarantine"
                                                        Style="{StaticResource NavButton}"
                                                        Click="Quarantine_Click"/>
                                        <Button Content="📜  Threat History"
                                                        Style="{StaticResource NavButton}"
                                                        Click="ThreatHistory_Click"/>
                                        <Button Content="🖥️  Settings"
                                                        Style="{StaticResource NavButton}"
                                                        Click="Settings_Click"/>
                                        <Button Content="🔑  License"
                                                        Style="{StaticResource NavButton}"
                                                        Click="License_Click"/>
                                </StackPanel>

                                <!-- Protection Status -->
                                <Border Grid.Row="2"
                                                Background="#161b22"
                                                CornerRadius="8"
                                                Margin="15,10,15,20"
                                                Padding="15">
                                        <StackPanel>
                                                <TextBlock Text="PROTECTION STATUS"
                                                                FontSize="10"
                                                                Foreground="#8b949e"
                                                                FontWeight="Bold"
                                                                Margin="0,0,0,10"/>
                                                <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="ProtectionIndicator"
                                                                        Width="12"
                                                                        Height="12"
                                                                        Fill="#238636"
                                                                        Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="ProtectionStatusText"
                                                                        Text="Protected"
                                                                        FontWeight="Bold"
                                                                        Foreground="#238636"
                                                                        FontSize="14"/>
                                                </StackPanel>
                                                <TextBlock x:Name="LastScanText"
                                                                Text="Last scan: Just now"
                                                                FontSize="11"
                                                                Foreground="#8b949e"
                                                                Margin="0,8,0,0"/>
                                        </StackPanel>
                                </Border>
                        </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Column="1"
                                Margin="25">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0"
                                        Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="HeaderTitle"
                                                        Text="Security Dashboard"
                                                        FontSize="28"
                                                        FontWeight="Bold"
                                                        Foreground="White"/>
                                        <TextBlock x:Name="HeaderSubtitle"
                                                        Text="Your system is being protected by SecureGuard AI"
                                                        FontSize="14"
                                                        Foreground="#8b949e"
                                                        Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Button Content="Check for Updates"
                                                        Style="{StaticResource ModernButton}"
                                                        Click="Update_Click"
                                                        Background="#1f6feb"/>
                                        <Button x:Name="QuickScanBtn"
                                                        Content="⚡ Quick Scan"
                                                        Style="{StaticResource ModernButton}"
                                                        Click="QuickScan_Click"/>
                                </StackPanel>
                        </Grid>

                        <!-- Stats Cards -->
                        <UniformGrid Grid.Row="1"
                                        Rows="1"
                                        Columns="4"
                                        Margin="0,0,0,25">
                                <!-- Threats Blocked -->
                                <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                                <TextBlock Text="THREATS BLOCKED"
                                                                FontSize="11"
                                                                Foreground="#8b949e"
                                                                FontWeight="SemiBold"/>
                                                <TextBlock x:Name="ThreatsBlockedCount"
                                                                Text="0"
                                                                FontSize="36"
                                                                FontWeight="Bold"
                                                                Foreground="#f85149"
                                                                Margin="0,10,0,5"/>
                                                <TextBlock Text="Today"
                                                                FontSize="12"
                                                                Foreground="#8b949e"/>
                                        </StackPanel>
                                </Border>

                                <!-- Files Scanned -->
                                <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                                <TextBlock Text="FILES SCANNED"
                                                                FontSize="11"
                                                                Foreground="#8b949e"
                                                                FontWeight="SemiBold"/>
                                                <TextBlock x:Name="FilesScannedCount"
                                                                Text="0"
                                                                FontSize="36"
                                                                FontWeight="Bold"
                                                                Foreground="#58a6ff"
                                                                Margin="0,10,0,5"/>
                                                <TextBlock Text="Total"
                                                                FontSize="12"
                                                                Foreground="#8b949e"/>
                                        </StackPanel>
                                </Border>

                                <!-- Security Score -->
                                <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                                <TextBlock Text="SECURITY SCORE"
                                                                FontSize="11"
                                                                Foreground="#8b949e"
                                                                FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SecurityScoreText"
                                                                Text="95%"
                                                                FontSize="36"
                                                                FontWeight="Bold"
                                                                Foreground="#3fb950"
                                                                Margin="0,10,0,5"/>
                                                <TextBlock Text="Excellent"
                                                                FontSize="12"
                                                                Foreground="#8b949e"/>
                                        </StackPanel>
                                </Border>

                                <!-- Protected Days -->
                                <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                                <TextBlock Text="PROTECTED DAYS"
                                                                FontSize="11"
                                                                Foreground="#8b949e"
                                                                FontWeight="SemiBold"/>
                                                <TextBlock x:Name="ProtectedDaysText"
                                                                Text="0"
                                                                FontSize="36"
                                                                FontWeight="Bold"
                                                                Foreground="#d29922"
                                                                Margin="0,10,0,5"/>
                                                <TextBlock Text="Days"
                                                                FontSize="12"
                                                                Foreground="#8b949e"/>
                                        </StackPanel>
                                </Border>
                        </UniformGrid>

                        <!-- Quick Actions -->
                        <Border Grid.Row="2"
                                        Style="{StaticResource Card}"
                                        Margin="5,0,5,25">
                                <StackPanel>
                                        <TextBlock Text="QUICK ACTIONS"
                                                        FontSize="14"
                                                        Foreground="#c9d1d9"
                                                        FontWeight="SemiBold"
                                                        Margin="0,0,0,15"/>
                                        <WrapPanel>
                                                <Button Content="🚀 Quick Scan"
                                                                Style="{StaticResource ModernButton}"
                                                                Click="QuickScan_Click"
                                                                Width="150"/>
                                                <Button Content="💾 Full Scan"
                                                                Style="{StaticResource ModernButton}"
                                                                Click="FullScan_Click"
                                                                Width="150"/>
                                                <Button Content="📂 Custom Scan"
                                                                Style="{StaticResource ModernButton}"
                                                                Click="CustomScan_Click"
                                                                Width="150"/>
                                                <Button x:Name="ProtectionToggleBtn"
                                                                Content="🛡️ Protection: ON"
                                                                Style="{StaticResource ModernButton}"
                                                                Click="StartProtection_Click"
                                                                Width="180"/>
                                                <Button Content="🔄 Update Definitions"
                                                                Style="{StaticResource ModernButton}"
                                                                Background="#1f6feb"
                                                                Click="Update_Click"
                                                                Width="180"/>
                                                <Button Content="📁 View Quarantine"
                                                                Style="{StaticResource ModernButton}"
                                                                Click="Quarantine_Click"
                                                                Width="150"/>
                                        </WrapPanel>
                                </StackPanel>
                        </Border>

                        <!-- Main Panel - Scan Progress / Results -->
                        <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="350"/>
                                </Grid.ColumnDefinitions>

                                <!-- Scan Panel -->
                                <Border Grid.Column="0"
                                                Style="{StaticResource Card}"
                                                Margin="5,0,5,0">
                                        <Grid>
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                                Text="SCAN STATUS"
                                                                FontSize="14"
                                                                Foreground="#c9d1d9"
                                                                FontWeight="SemiBold"
                                                                Margin="0,0,0,15"/>

                                                <StackPanel Grid.Row="1"
                                                                VerticalAlignment="Center">
                                                        <!-- Shield Icon -->
                                                        <Border x:Name="ScanShieldIcon"
                                                                        Width="120"
                                                                        Height="120"
                                                                        CornerRadius="60"
                                                                        Background="#161b22"
                                                                        Margin="0,0,0,30"
                                                                        HorizontalAlignment="Center">
                                                                <TextBlock Text="🛡️"
                                                                                FontSize="50"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock x:Name="ScanStatusText"
                                                                        Text="Ready to Scan"
                                                                        FontSize="24"
                                                                        FontWeight="Bold"
                                                                        Foreground="White"
                                                                        HorizontalAlignment="Center"/>
                                                        <TextBlock x:Name="ScanSubStatus"
                                                                        Text="Click Quick Scan or Full Scan to begin"
                                                                        FontSize="14"
                                                                        Foreground="#8b949e"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,10,0,0"/>

                                                        <!-- Progress -->
                                                        <ProgressBar x:Name="ScanProgress"
                                                                        Height="8"
                                                                        Background="#21262d"
                                                                        Foreground="#238636"
                                                                        Value="0"
                                                                        Maximum="100"
                                                                        Margin="0,25,0,0"
                                                                        Visibility="Collapsed"/>
                                                        <TextBlock x:Name="ScanProgressText"
                                                                        Text=""
                                                                        FontSize="12"
                                                                        Foreground="#8b949e"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,10,0,0"
                                                                        Visibility="Collapsed"/>

                                                        <!-- Scan Stats -->
                                                        <Grid x:Name="ScanStatsPanel"
                                                                        Margin="0,25,0,0"
                                                                        Visibility="Collapsed">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
                                                                                HorizontalAlignment="Center">
                                                                        <TextBlock x:Name="ScanFilesCount"
                                                                                        Text="0"
                                                                                        FontSize="28"
                                                                                        FontWeight="Bold"
                                                                                        Foreground="#58a6ff"
                                                                                        HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Files Scanned"
                                                                                        FontSize="11"
                                                                                        Foreground="#8b949e"
                                                                                        HorizontalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1"
                                                                                HorizontalAlignment="Center">
                                                                        <TextBlock x:Name="ScanThreatsFound"
                                                                                        Text="0"
                                                                                        FontSize="28"
                                                                                        FontWeight="Bold"
                                                                                        Foreground="#f85149"
                                                                                        HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Threats Found"
                                                                                        FontSize="11"
                                                                                        Foreground="#8b949e"
                                                                                        HorizontalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2"
                                                                                HorizontalAlignment="Center">
                                                                        <TextBlock x:Name="ScanTimeElapsed"
                                                                                        Text="0s"
                                                                                        FontSize="28"
                                                                                        FontWeight="Bold"
                                                                                        Foreground="#d29922"
                                                                                        HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="Time Elapsed"
                                                                                        FontSize="11"
                                                                                        Foreground="#8b949e"
                                                                                        HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                        </Grid>
                                                </StackPanel>
                                        </Grid>
                                </Border>

                                <!-- Right Panel -->
                                <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Recent Threats -->
                                        <Border Grid.Row="0"
                                                        Style="{StaticResource Card}"
                                                        Margin="5,0,5,5">
                                                <Grid>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                        Text="RECENT THREATS"
                                                                        FontSize="14"
                                                                        Foreground="#c9d1d9"
                                                                        FontWeight="SemiBold"
                                                                        Margin="0,0,0,15"/>

                                                        <ListBox x:Name="ThreatList"
                                                                        Grid.Row="1"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Foreground="#c9d1d9">
                                                                <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <Border Background="#21262d"
                                                                                                CornerRadius="6"
                                                                                                Padding="12,8"
                                                                                                Margin="0,2">
                                                                                        <StackPanel>
                                                                                                <TextBlock Text="{Binding ThreatName}"
                                                                                                                FontWeight="SemiBold"
                                                                                                                Foreground="#f85149"
                                                                                                                FontSize="13"/>
                                                                                                <TextBlock Text="{Binding FilePath}"
                                                                                                                Foreground="#8b949e"
                                                                                                                FontSize="11"
                                                                                                                TextTrimming="CharacterEllipsis"/>
                                                                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                                                                                Foreground="#6e7681"
                                                                                                                FontSize="10"/>
                                                                                        </StackPanel>
                                                                                </Border>
                                                                        </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                        </ListBox>
                                                </Grid>
                                        </Border>

                                        <!-- Protection Features -->
                                        <Border Grid.Row="1"
                                                        Style="{StaticResource Card}"
                                                        Margin="5,5,5,0">
                                                <Grid>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                        Text="PROTECTION FEATURES"
                                                                        FontSize="14"
                                                                        Foreground="#c9d1d9"
                                                                        FontWeight="SemiBold"
                                                                        Margin="0,0,0,15"/>

                                                        <StackPanel Grid.Row="1">
                                                                <CheckBox x:Name="RealtimeProtectionChk"
                                                                                Content="Real-Time Protection"
                                                                                Foreground="#c9d1d9"
                                                                                IsChecked="True"
                                                                                Margin="0,8"
                                                                                Checked="RealtimeProtection_Changed"
                                                                                Unchecked="RealtimeProtection_Changed"/>
                                                                <CheckBox x:Name="RansomwareChk"
                                                                                Content="Ransomware Shield"
                                                                                Foreground="#c9d1d9"
                                                                                IsChecked="True"
                                                                                Margin="0,8"/>
                                                                <CheckBox x:Name="NetworkProtectionChk"
                                                                                Content="Network Protection"
                                                                                Foreground="#c9d1d9"
                                                                                IsChecked="True"
                                                                                Margin="0,8"/>
                                                                <CheckBox x:Name="UsbScanChk"
                                                                                Content="USB Auto-Scan"
                                                                                Foreground="#c9d1d9"
                                                                                IsChecked="True"
                                                                                Margin="0,8"/>
                                                                <CheckBox x:Name="PrivacyChk"
                                                                                Content="Privacy Protection"
                                                                                Foreground="#c9d1d9"
                                                                                IsChecked="True"
                                                                                Margin="0,8"/>
                                                                <CheckBox x:Name="CloudIntelChk"
                                                                                Content="Cloud Intelligence"
                                                                                Foreground="#c9d1d9"
                                                                                IsChecked="True"
                                                                                Margin="0,8"/>
                                                        </StackPanel>
                                                </Grid>
                                        </Border>
                                </Grid>
                        </Grid>
                </Grid>
        </Grid>
</Window>

